# Minimal loader image context. Deny sensitive and generated content at every depth.
*
!docker
!docker/loader
!docker/loader/**
!loader
!loader/**
!package.json
!package-lock.json
!web
!web/kit
!web/kit/components
!web/kit/components/ui
!web/kit/components/ui/**
!web/kit/hooks
!web/kit/hooks/**
!web/kit/lib
!web/kit/lib/**
!web/kit/theme.css
!web/kit/components.json
!web/kit/registry-lock
!web/kit/registry-lock/manifest.json
!web/kit/registry-lock/files
!web/kit/registry-lock/files/**
!web/loader
!web/loader/src
!web/loader/src/**
!web/loader/public
!web/loader/public/**
!web/loader/index.html
!web/loader/vite.config.ts
!web/loader/tsconfig.json
!web/loader/package.json
!.docker-context
!.docker-context/**
!.docker-context/seed.bundle
**/.env
**/.env.*
**/.git
**/.git/**
**/node_modules
**/node_modules/**
**/dist
**/dist/**
**/coverage
**/coverage/**
**/*.local
**/*.log
**/*.pem
**/*.key
**/secrets/**
**/.dockerignore
