# Timezone (IANA name, e.g. Europe/Moscow, America/New_York)
TZ=UTC

# ── Telegram ────────────────────────────────────────────────
# Bot token from @BotFather
# Your Telegram chat ID — enables proactive messaging.
# DM @userinfobot and send /start to get it.

# ── Model endpoint (OpenAI-compatible, the only model configuration) ──
# Every model request goes to this OpenAI-compatible endpoint; the model key
# is never set here. In the Docker instance Agent Vault injects the key on the
# way out, so a container started with OPENROUTER_API_KEY (or any other model
# key variable) keeps that key out of lifemodel's process.
# Supports LM Studio, Ollama, LocalAI, vLLM, LiteLLM, etc.
LLM_ENDPOINT_BASE_URL=
# Fast model: cheap — classification, yes/no, emotion detection
LLM_ENDPOINT_FAST_MODEL=
# Smart model: expensive — message composition, reasoning
LLM_ENDPOINT_SMART_MODEL=
# Model used by the Motor Cortex agentic runtime
LLM_ENDPOINT_MOTOR_MODEL=

# ── Plugins ─────────────────────────────────────────────────
# Only the external plugins directory (outside the tracked tree)
PLUGINS_DIR=
# Plugin ids to enable/disable, comma-separated
PLUGINS_ENABLED=
PLUGINS_DISABLED=

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=info
# Pretty, colourised pino output for a development run. Off by default: a
# cluster module writes one JSON record per line, which is what the logs page
# reads. Set it explicitly for `npm run dev`, never in the cluster.
LOG_PRETTY=false

# ── Web search (optional) ───────────────────────────────────
SERPER_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
# Provider fallback order, e.g. serper,tavily
SEARCH_PROVIDER_PRIORITY=
