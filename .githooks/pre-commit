#!/bin/sh
# pre-commit — the backlog gate and the tracker layout guard.
#
# Team scope: this hook ships with the repository and `npm run connect`
# (scripts/connect-clone.sh) points git at .githooks. The product checks
# (lint-staged, tsc, vitest) are NOT here: they live in .husky/pre-commit and
# need node_modules. When husky is active (npm ci ran, so core.hooksPath is
# .husky/_), .husky/pre-commit runs them and this gate with them. When it is
# not, this hook runs the gate alone and says so; CI runs the product checks.
set -eu

fail() { printf 'FAIL: %s\n' "$1" >&2; exit 1; }

command -v node >/dev/null 2>&1 || fail "node is not on PATH — the backlog gate runs on it. Install Node.js 24+ or run: npm run connect"

gate=.backlog
for f in adapter.mjs gate.mjs merge-gate.mjs config.json; do
    if [ ! -f "$gate/$f" ]; then
        printf 'pre-commit: %s is missing from this checkout; run npm run connect, which names what is missing\n' "$gate/$f" >&2
        exit 1
    fi
done
for f in check.mjs time-format.mjs check-product.mjs regular-file.mjs argv.mjs; do
    if [ ! -f "$gate/rules/$f" ]; then
        printf 'pre-commit: %s is missing from this checkout; run npm run connect, which names what is missing\n' "$gate/rules/$f" >&2
        exit 1
    fi
done

node "$gate/rules/check-product.mjs" --staged

# --- 1. the tracker layout --------------------------------------------------
# The tracker lives outside the code branches (docs/backlog-integration.md,
# Tracker layout): .beads is this machine's link to its store and no commit
# carries a tracker record. A staged path under it is a store file reaching a
# branch, whatever the branch; deleting one (the move's own commit) is allowed.
if git diff --cached --name-only --diff-filter=d -- .beads | grep -q .; then
    printf 'TRACKER: a tracker file is staged:\n' >&2
    git diff --cached --name-only --diff-filter=d -- .beads | sed 's/^/         /' >&2
    printf '         The tracker lives in this machine'"'"'s store, outside every branch; .beads is\n' >&2
    printf '         only the link to it. Unstage it and commit the rest: git restore --staged .beads\n' >&2
    exit 1
fi

# --- 2. the backlog gate ----------------------------------------------------
# The store as it is now, judged against what the store recorded at HEAD (or
# the newest recording before it), without a network round: a commit must not
# wait on the remote. Exit 1 is red and exit 2 is misuse — a gate that cannot
# run is as red as one that found a problem; both refuse the commit.
node "$gate/gate.mjs" --offline
printf 'OK:   backlog gate\n'

printf 'note: the product checks (lint-staged, tsc, vitest) are not run here; run them with npm ci + husky, or in CI.\n'
