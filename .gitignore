# Dependencies
node_modules/

# Build output
dist/

# The seed bundle scripts/build-image.sh writes into the build context for the
# length of a docker build; it removes it again.
.docker-context/

# Data (mounted volume in production)
data/

# Keep config template but ignore actual config
!data/config/.gitkeep

# Environment
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Logs
*.log

# Coverage
coverage/
