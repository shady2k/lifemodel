set -e
npx lint-staged

# lint-staged needs the hook's GIT_* to see the staged files; the checks after
# it must not see them at all: a test that runs git would act on THIS
# repository (lifemodel-q4x.4.2). They never start on the host: the isolated
# launcher runs them inside the disposable test boundary
# (scripts/test-isolated.mjs, see AGENTS.md), and tests/setup/scrub-git-env.ts
# scrubs them again inside the suite (the policy test at
# tests/unit/test-entrypoints.test.ts pins the subshell's exact form - the
# launcher's minimal unset list).
#
# The gates AFTER the subshell keep the ORIGINAL git environment on purpose: git
# supplies a commit-specific GIT_INDEX_FILE for `git commit --only <path>`, and
# both the tracker guard (`git diff --cached`) and the backlog gate (which reads
# the staged export at `:0` via GIT_INDEX_FILE) must judge THAT index - the one
# the commit is actually made from - not the repository's default index
# (lifemodel-q4x.4.2, review finding 6).
(
    unset GIT_INDEX_FILE GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR \
        GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
    node scripts/test-isolated.mjs check
)

# --- BEGIN LIFEMODEL BACKLOG GATE ---
if ! command -v node >/dev/null 2>&1 || [ ! -f .backlog/rules/check-product.mjs ]; then
    printf "pre-commit: the product-document check cannot run; run npm run connect\n" >&2
    exit 1
fi
node .backlog/rules/check-product.mjs --staged || exit 1
# Managed by scripts/connect-clone.sh. The tracker lives outside the code
# branches: .beads is the link to the store of this machine, never committed.
if git diff --cached --name-only --diff-filter=d -- .beads 2>/dev/null | grep -q .; then
    printf "TRACKER: a tracker file is staged; the tracker lives in the store of this machine, outside every branch. Unstage it: git restore --staged .beads\n" >&2
    exit 1
fi
node .backlog/gate.mjs --offline || exit 1
# --- END LIFEMODEL BACKLOG GATE ---
