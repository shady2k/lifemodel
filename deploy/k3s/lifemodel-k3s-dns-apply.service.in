[Unit]
Description=Reconcile CoreDNS with the desired host resolver
After=k3s.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
TimeoutStartSec=180
Restart=on-failure
RestartSec=30
# Host-Commands: node mkdir flock cat rm cp mv sleep k3s systemctl
# Requires Node.js, coreutils, util-linux, k3s and systemd in the PATH below.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=@DNS_APPLY_SH@ @RESOLV_CONF@ @RESOLV_MJS@ /etc/resolv.conf /run/systemd/resolve/resolv.conf

[Install]
WantedBy=multi-user.target
