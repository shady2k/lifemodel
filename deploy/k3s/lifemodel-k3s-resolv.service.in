[Unit]
Description=Write the resolv.conf k3s gives the kubelet and CoreDNS
Before=k3s.service
StartLimitIntervalSec=0

[Service]
# Must be inactive after exit so path triggers can regenerate again.
Type=oneshot
TimeoutStartSec=30
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=@RESOLV_SH@ @RESOLV_MJS@ @RESOLV_CONF@ /etc/resolv.conf /run/systemd/resolve/resolv.conf

[Install]
WantedBy=multi-user.target
