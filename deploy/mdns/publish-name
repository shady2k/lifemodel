#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 2 ]]; then
  echo "usage: publish-name NAME.local INTERFACE" >&2
  exit 2
fi
name=$1
iface=$2
child=
monitor_pid=
monitor_fd=
stop=0
cleanup() {
  trap - EXIT INT TERM
  if [[ -n "$child" ]]; then kill "$child" 2>/dev/null || true; wait "$child" 2>/dev/null || true; fi
  if [[ -n "$monitor_pid" ]]; then kill "$monitor_pid" 2>/dev/null || true; wait "$monitor_pid" 2>/dev/null || true; fi
  if [[ -n "$monitor_fd" ]]; then exec {monitor_fd}<&- 2>/dev/null || true; fi
}
stop_now() { exit 0; }
trap cleanup EXIT
trap stop_now INT TERM

address() {
  ip -o -4 addr show dev "$iface" scope global | awk '{ split($4, a, "/"); print a[1]; exit }'
}

# A missing interface is an operational failure. No address on a present
# interface is normal and remains a visible wait for DHCP/address assignment.
ip link show dev "$iface" >/dev/null || { echo "Interface $iface is unavailable" >&2; exit 1; }
echo "Waiting for IPv4 address on $iface to publish $name" >&2
coproc MONITOR { exec ip monitor address dev "$iface"; }
monitor_pid=$MONITOR_PID
monitor_fd=${MONITOR[0]}
last=$(address) || { echo "Cannot read IPv4 address on $iface" >&2; exit 1; }

publish() {
  if [[ -n "$child" ]]; then
    kill "$child" 2>/dev/null || true
    wait "$child" 2>/dev/null || true
    child=
  fi
  last=$1
  if [[ -n "$last" ]]; then
    echo "Publishing $name at $last on $iface" >&2
    # The host owns the address PTR; several names cannot share it.
    avahi-publish-address -R "$name" "$last" &
    child=$!
  else
    echo "No IPv4 address on $iface; waiting to publish $name" >&2
  fi
}
publish "$last"
while :; do
  if ! kill -0 "$monitor_pid" 2>/dev/null; then
    wait "$monitor_pid" || { echo "Address monitor failed for $iface" >&2; exit 1; }
    echo "Address monitor ended unexpectedly for $iface" >&2; exit 1
  fi
  if [[ -n "$child" ]] && ! kill -0 "$child" 2>/dev/null; then
    wait "$child" || { echo "avahi-publish-address failed for $name (possible name collision)" >&2; exit 1; }
    echo "avahi-publish-address exited unexpectedly for $name" >&2; exit 1
  fi
  if IFS= read -r -t 1 -u "$monitor_fd" event; then
    ip link show dev "$iface" >/dev/null || { echo "Interface $iface disappeared" >&2; exit 1; }
    current=$(address) || { echo "Cannot read IPv4 address on $iface" >&2; exit 1; }
    [[ "$current" == "$last" ]] || publish "$current"
  else
    read_status=$?
    if (( read_status < 128 )); then
      wait "$monitor_pid" 2>/dev/null || { echo "Address monitor failed for $iface" >&2; exit 1; }
      echo "Address monitor ended unexpectedly for $iface" >&2
      exit 1
    fi
  fi
done
