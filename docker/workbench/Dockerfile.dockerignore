# Dedicated checkout-root workbench context. Admit files, never directories.
*
!docker/workbench/Dockerfile
!docker/workbench/lifemodel-task-launcher
!docker/workbench/*.json
!docker/workbench/*.txt
!docker/workbench/steering-plugin/package.json
!docker/workbench/steering-plugin/index.mjs
!scripts/task-agent-provision.mjs
!docker/loader/lifemodel-storage
!package.json
!package-lock.json
!loader/package.json
!loader/package-lock.json
!loader/tsconfig.json
!scripts/task-start-manifest.mjs
!loader/src/**/*.ts
# Defense in depth even inside admitted source paths.
**/.npmrc
**/.env
**/.env.*
**/*.pem
**/*.key
**/.git*
**/id_*
**/secrets/**

!src/ports/task-harness-registry.json

!src/ports/task-agent-validation.*
!scripts/task-agent-paths.mjs

!src/ports/task-transcript-bounds.*

!src/ports/task-output-names.*
