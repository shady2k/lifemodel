{
  "$schema": "https://opencode.ai/v2/config.json",
  "update": "disable",
  "share": "disabled",
  "formatter": false,
  "lsp": false,
  "warming": false,
  "snapshots": false,
  "plugins": ["-opencode.browser"],
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "question",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "agents": {
    "title": {
      "disabled": true
    },
    "summary": {
      "disabled": true
    }
  }
}
