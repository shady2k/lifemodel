ARG BASE=probe-6539/workbench:stock
FROM ${BASE}
USER root
COPY prime-agent /opt/probe/prime-agent
RUN apt-get update -o APT::Update::Error-Mode=any && apt-get install -y --no-install-recommends python3-venv && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/probe/python
RUN /opt/probe/python/bin/python -m pip install --no-cache-dir /opt/probe/prime-agent/prime-agent-runtime dill requests httpx pyyaml tomli python-dotenv pandas numpy scipy beautifulsoup4 lxml pydantic tyro
RUN chmod -R a+rX /opt/probe
USER 1000:1000
ENTRYPOINT ["node", "/probe/run-probe.mjs"]
