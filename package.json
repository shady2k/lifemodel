{
  "name": "lifemodel",
  "version": "0.1.0",
  "description": "Human-like proactive AI agent",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc && cp -r src/runtime/builtin-skills dist/runtime/builtin-skills",
    "build:loader": "tsc -p loader/tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src/ loader/ web/app/ web/loader/src/",
    "lint:fix": "eslint src/ loader/ web/app/ web/loader/src/ --fix",
    "typecheck": "tsc --noEmit",
    "typecheck:loader": "tsc -p loader/tsconfig.json --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"loader/**/*.ts\" \"web/app/**/*.{ts,tsx,css,json,html}\" \"web/kit/**/*.{ts,tsx,css,json,html}\" \"web/loader/**/*.{ts,tsx,css,json,html}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"loader/**/*.ts\" \"web/app/**/*.{ts,tsx,css,json,html}\" \"web/kit/**/*.{ts,tsx,css,json,html}\" \"web/loader/**/*.{ts,tsx,css,json,html}\"",
    "test": "node scripts/test-isolated.mjs test",
    "test:docker": "node scripts/test-isolated.mjs docker",
    "test:watch": "echo 'test:watch is unsupported: the isolated launcher runs the suite one-shot and bounded and has no watch option yet, and watch on the host is forbidden by the test entrypoint policy; run one bounded suite instead: node scripts/test-isolated.mjs test -- <path>' >&2 && exit 1",
    "check": "node scripts/test-isolated.mjs check",
    "prepare": "husky",
    "browser:auth": "tsx cli/browser-auth.ts",
    "connect": "sh scripts/connect-clone.sh",
    "backlog": "node .backlog/gate.mjs --worktree",
    "backlog:json": "node .backlog/gate.mjs --worktree --json",
    "ready": "node .backlog/ready.mjs",
    "present": "node .backlog/rules/check-present.mjs --config .backlog/config.json --base \"${BASE:-$(git merge-base origin/main HEAD 2>/dev/null || git rev-parse HEAD)}\"",
    "build:app": "vite build --config web/app/vite.config.ts",
    "dev:web": "vite --config web/app/vite.config.ts",
    "build:web-server": "esbuild src/web/index.ts --bundle --platform=node --format=cjs --outfile=dist/web/server.cjs",
    "build:web": "npm run build:web-server && npm run build:app",
    "build:loader-ui": "vite build --config web/loader/vite.config.ts",
    "typecheck:loader-ui": "tsc -p web/loader/tsconfig.json --noEmit"
  },
  "keywords": [
    "ai",
    "agent",
    "proactive",
    "human-like"
  ],
  "lint-staged": {
    "*.ts": "eslint --max-warnings 0",
    "*.{ts,json}": "prettier --check"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@marcbachmann/cel-js": "8.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.0.10",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.1.2",
    "axe-core": "^4.11.0",
    "esbuild": "0.27.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jest-axe": "^10.0.0",
    "jsdom": "^27.3.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "shadcn": "4.21.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.2.2",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.27",
    "@fontsource-variable/jetbrains-mono": "^5.2.6",
    "@fontsource-variable/onest": "^5.2.6",
    "@grammyjs/runner": "^2.0.3",
    "@huggingface/transformers": "^3.8.1",
    "@peculiar/x509": "2.2.0",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-virtual": "^3.14.20",
    "ai": "^6.0.82",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "cron-parser": "^5.5.0",
    "dotenv": "^17.2.3",
    "fast-xml-parser": "^5.3.4",
    "fastify": "^5.12.7",
    "grammy": "^1.39.3",
    "gray-matter": "^4.0.3",
    "i18next": "^25.6.3",
    "iconv-lite": "^0.7.2",
    "iovalkey": "^0.3.3",
    "lucide-react": "^0.562.0",
    "luxon": "^3.7.2",
    "node-html-parser": "^7.0.2",
    "pg": "^8.23.1",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "radix-ui": "^1.4.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^16.3.5",
    "react-markdown": "^10.1.0",
    "reflect-metadata": "0.2.2",
    "remark-gfm": "^4.0.1",
    "semver": "^7.7.3",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.1.18",
    "turndown": "^7.2.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  }
}
