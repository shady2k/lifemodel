{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@kit/*": ["../kit/*"],
      "@/components/ui/*": ["../kit/components/ui/*"],
      "@/hooks/*": ["../kit/hooks/*"],
      "@/lib/utils": ["../kit/lib/utils"],
      "@/lib/highlighter": ["../kit/lib/highlighter"]
    },
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts", "../kit/**/*.ts", "../kit/**/*.tsx"]
}
